# ---------------------------------------------------------------------------
# Root Connect backend configuration. Copy to `backend/.env` and fill in.
# (env.ts also loads a root ../.env, so shared vars can live there instead.)
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=4000
# Public URL used for links in invite, reset and verification emails.
# Three accepted forms:
#   <a URL>  used exactly as given. A domain or load balancer must win here —
#            the raw instance IP would be wrong behind one, not just uglier.
#   auto     ask EC2 instance metadata for this box's own public IPv4 at
#            startup. EC2 only; lets a stop/start correct itself with no
#            deploy and no shell access. This is what the deploy workflow
#            writes by default.
#   unset    the development default, http://localhost:5173. No metadata
#            probe, so an unconfigured box never advertises a real public IP.
APP_URL=http://localhost:5173
# Safety net for APP_URL=auto only, ignored otherwise. Used when metadata is
# unreachable (endpoint disabled, hop limit 1, container, no public IPv4).
# The deploy workflow rewrites this with the address seen at deploy time.
# Without it such a failure would put localhost into live emails and still
# ship green, because the deploy's health check only ever talks to localhost.
APP_URL_FALLBACK=

# --- Database (Amazon RDS for PostgreSQL) ----------------------------------
# Dev falls back to the local Docker Postgres if DATABASE_URL is unset.
# Prod / dev-against-RDS: set this to your RDS endpoint.
#   postgres://<user>:<password>@<rds-endpoint>:5432/<db>
DATABASE_URL=postgres://roo:roo_dev_pw@localhost:5433/rooconnect
# RDS requires TLS. Set true when pointing at RDS (auto-on when NODE_ENV=production).
DATABASE_SSL=false

# --- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate one: `openssl rand -hex 32`
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=7d
# Password given to seeded demo accounts (dev only).
SEED_PASSWORD=roomandemo
# Password for the console admin account (admin@rooman.com).
ADMIN_PASSWORD=

# --- Integrations (optional) -----------------------------------------------
# Google OAuth Web client id — makes "Continue with Google" real.
# Create at https://console.cloud.google.com/apis/credentials
#   → Create Credentials → OAuth client ID → Web application
#   → Authorized JavaScript origins: http://localhost:5173 (+ your prod URL)
# Leave empty to keep the simulated Google button.
GOOGLE_CLIENT_ID=

# --- AI (Ask Roo + resume parsing) -----------------------------------------
# REQUIRED for both AI features. Both run on free NVIDIA Nemotron models via
# OpenRouter; without this key resume upload and Ask Roo return 503 (there is
# no demo/sample-data mode — invented profile data must never reach a real
# member's onboarding form). Get a key at https://openrouter.ai/keys.
# Note the free tier's ~50 requests/day ceiling.
OPENROUTER_API_KEY=

# Learning Resources matching (embeddings) — background only, never on a page
# load. Defaults to the free nvidia/nemotron-3-embed-1b:free on the key above.
# To switch (e.g. to OpenAI), set the model — and ideally its own key, since
# the free tier's daily ceiling is shared with Ask Roo — then run
# `npm run learning:calibrate` and paste the three EMBED_* lines it prints.
# The worker re-embeds everything with the new model by itself.
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBED_API_KEY=
# EMBED_RELATED_MIN=
# EMBED_RELATED_WITH_TAG_MIN=
# EMBED_RELATED_WITH_ROLE_MIN=
# EMBED_SAME_STAGE_MIN=

# Optional escape hatch: set AI_PROVIDER=anthropic to run both features on paid
# Claude via ANT_KEY instead (no rate ceiling). Unset — the default — means
# OpenRouter, and ANT_KEY is then not read at all.
# AI_PROVIDER=anthropic
# ANT_KEY=
# SMTP for real invite emails (else invites are simulated).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
